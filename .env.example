# CampusFlow — configuration template
#
# Copy to .env and edit. This file is documentation: it carries no secrets
# and is never read at runtime. The live .env is plain KEY=value with no
# comments, and every key below is editable from the in-app control room
# (the gear icon) if you are signed in as the accountant.
#
# Precedence: real environment variables beat this file, which beats the
# built-in defaults shown here. Blank values mean "not configured".

# --- Server --- ---------------------------------------------
# Where the API listens and how it is served.
# Port
# (takes effect on restart)
PORT=3000
# Bind address
# (takes effect on restart)
HOST=0.0.0.0
# Environment
NODE_ENV=development
# Trust X-Forwarded-*
TRUST_PROXY=false
# Allowed CORS origin — Blank = same-origin only.
CORS_ORIGIN=

# --- AI providers --- ---------------------------------------
# Two keys. Which models you get is discovered from the keys themselves,
# so there is no model list to maintain here.
# Gemini API key — Primary. aistudio.google.com/apikey — serves every gemini-* model it lists.
GEMINI_API_KEY=
# OpenCode Zen API key — Backup. https://opencode.ai/auth — serves 80+ models; used when Gemini
# is missing, out of quota, or for non-Gemini models.
OPENCODE_ZEN_API_KEY=
# Provider priority — Which key to try first, and whether the other may take over when one is
# throttled or missing. Applies immediately, no restart.
#   auto = Gemini first, Zen as the safety net (default)
#   gemini-first / zen-first = pin one to the front, keep failover
#   gemini-only / zen-only = refuse to fall back at all
AI_PROVIDER_ORDER=auto
# Zen gateway URL — Point at a proxy or a self-hosted gateway here.
# (takes effect on restart)
OPENCODE_ZEN_URL=https://opencode.ai/zen/v1

# --- Model routing --- --------------------------------------
# Models are discovered per key and ranked into fast/deep chains automatically.
# Default tier
# (takes effect on restart)
AI_TIER=fast
# Pin a model chain — Blank = use the discovered ranking. Otherwise provider:model entries, e.g.
# gemini:gemini-3.8-flash,zen:kimi-k3.
# (takes effect on restart)
AI_MODEL_CHAIN=
# Request timeout (ms)
# (takes effect on restart)
AI_TIMEOUT_MS=25000
# Cache TTL (ms)
# (takes effect on restart)
AI_CACHE_TTL_MS=300000
# Catalogue refresh (ms) — How often the provider model lists are re-read.
# (takes effect on restart)
AI_DISCOVERY_TTL_MS=900000
# Rate-limit cooldown (ms) — How long a 429-throttled key is parked before the other
# provider is tried.
# (takes effect on restart)
AI_RATE_LIMIT_COOLDOWN_MS=60000

# --- Tokens & sessions --- ----------------------------------
# Signing key, access-token lifetime and refresh rotation.
# Token signing secret — Blanks fall back to .token-secret. Changing it signs everyone out.
# (takes effect on restart)
TOKEN_SECRET=
# Access token TTL (s)
# (takes effect on restart)
TOKEN_TTL_SECONDS=28800
# Token issuer
# (takes effect on restart)
TOKEN_ISSUER=campusflow
# Token audience
# (takes effect on restart)
TOKEN_AUDIENCE=campusflow-web
# Refresh token TTL (s)
TOKEN_REFRESH_TTL_SECONDS=1209600

# --- Cookies --- --------------------------------------------
# HttpOnly cookie transport so the browser never touches the raw token.
# Session cookie
TOKEN_COOKIE_NAME=cf_session
# Refresh cookie
TOKEN_COOKIE_REFRESH_NAME=cf_refresh
# Secure flag — Turn on whenever the app is served over HTTPS.
TOKEN_COOKIE_SECURE=false
# SameSite
TOKEN_COOKIE_SAMESITE=lax
# Cookie domain — Blank = host-only.
TOKEN_COOKIE_DOMAIN=
# Cookie path
TOKEN_COOKIE_PATH=/

# --- Authentication policy --- ------------------------------
# Lockout, MFA, personal access tokens and CSRF.
# Failed tries before lockout
AUTH_MAX_LOGIN_ATTEMPTS=8
# Lockout duration (ms)
AUTH_LOCKOUT_MS=900000
# Throttle window (ms)
# (takes effect on restart)
AUTH_THROTTLE_WINDOW_MS=60000
# Logins per window
# (takes effect on restart)
AUTH_THROTTLE_MAX=40
# Require MFA for everyone
AUTH_REQUIRE_MFA=false
# MFA issuer label
AUTH_MFA_ISSUER=CampusFlow
# TOTP step (s)
AUTH_MFA_TOTP_STEP=30
# TOTP digits
AUTH_MFA_TOTP_DIGITS=6
# API key prefix
AUTH_API_KEY_PREFIX=cf_live
# API key TTL (s, 0 = never)
AUTH_API_KEY_TTL_SECONDS=0
# CSRF double-submit
AUTH_CSRF_ENABLED=true
# CSRF header name
AUTH_CSRF_HEADER=x-csrf-token
# Audit retention (days)
AUTH_AUDIT_RETENTION_DAYS=90
# One-click demo login — Off = email + password only. The switcher in the UI then dies.
ALLOW_ONE_CLICK_LOGIN=true

# --- Data & observability --- -------------------------------
# Where state lives and how much noise the server prints.
# SQLite path — Blank = ./campus.db. Only change before the first boot.
CAMPUS_DB_PATH=
# Env file path — Blank = ./.env
# (takes effect on restart)
CAMPUS_ENV_FILE=
# Log level
LOG_LEVEL=info
# Log every request
LOG_REQUESTS=false
# Global rate window (ms)
RATE_LIMIT_WINDOW_MS=60000
# Global requests per window
RATE_LIMIT_MAX=600
